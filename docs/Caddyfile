www.zhouzhouzhang.co.uk, anonchihaya.co.uk, www.anonchihaya.co.uk {
    redir https://zhouzhouzhang.co.uk{uri} permanent
}

zhouzhouzhang.co.uk {
    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
        -Server
    }

    @api path /api*
    handle @api {
        # Compose service name; Caddy and the app share the compose network.
        reverse_proxy anoweb:8080
    }

    handle_path /image/* {
        root * /srv/images
        header Cache-Control "public, max-age=604800"
        file_server
    }

    # Everything else → Next.js SSR frontend
    handle {
        reverse_proxy anoweb-front:3000
    }
}
